{
  "telemetry.telemetryLevel": "off",
  "telemetry.enableTelemetry": false,
  "telemetry.enableCrashReporter": false,
  "workbench.enableExperiments": false,
  "workbench.settings.enableNaturalLanguageSearch": false,
  "workbench.startupEditor": "none",
  "window.restoreWindows": "none",
  "files.hotExit": "off",
  "workbench.welcomePage.walkthroughs.openOnInstall": false,
  "explorer.autoReveal": false,
  "files.exclude": {
    "**/.venv": true,
    "**/ide-data": true,
    "**/ide-extensions": true,
    "**/extensions/talon.talon-guard-*": true,
    "**/__pycache__": true
  },
  "window.openFoldersInNewWindow": "off",
  "workbench.editor.empty.hint": "hidden",
  "workbench.sideBar.location": "left",
  "workbench.secondarySideBar.defaultVisibility": "visible",
  "workbench.tips.enabled": false,
  "workbench.cloudChanges.autoResume": "off",
  "workbench.cloudChanges.continueOn": "off",
  "window.title": "Talon — local — kit only — Ollama down — ${rootName}${separator}${activeEditorShort}",
  "window.titleBarStyle": "custom",
  "window.menuStyle": "custom",
  "window.commandCenter": false,
  "chat.disableAIFeatures": true,
  "chat.commandCenter.enabled": false,
  "chat.mcp.access": "none",
  "inlineChat.enable": false,
  "extensions.autoCheckUpdates": false,
  "extensions.autoUpdate": false,
  "extensions.ignoreRecommendations": true,
  "update.mode": "none",
  "update.showReleaseNotes": false,
  "update.enableWindowsBackgroundUpdates": false,
  "http.systemCertificates": true,
  "npm.fetchOnlinePackageInfo": false,
  "npm.autoDetect": "off",
  "json.schemaDownload.enable": false,
  "typescript.disableAutomaticTypeAcquisition": true,
  "html.autoClosingTags": true,
  "php.suggest.basic": false,
  "git.enabled": false,
  "git.openRepositoryInParentFolders": "never",
  "git.autoRepositoryDetection": false,
  "git.repositoryScanMaxDepth": 0,
  "git.detectSubmodules": false,
  "git.scanRepositories": [],
  "git.autofetch": false,
  "git.fetchOnPull": false,
  "git.confirmSync": true,
  "git.terminalAuthentication": false,
  "git.useIntegratedAskPass": false,
  "git.allowForcePush": false,
  "git.autoStash": false,
  "git.postCommitCommand": "none",
  "github.gitAuthentication": false,
  "github.showAvatar": false,
  "github.branchProtection": false,
  "remote.autoForwardPorts": false,
  "remote.downloadExtensionsLocally": true,
  "terminal.integrated.enablePersistentSessions": false,
  "terminal.integrated.environmentChangesIndicator": "off",
  "security.workspace.trust.enabled": true,
  "security.workspace.trust.startupPrompt": "always",
  "python.defaultInterpreterPath": "__LOCALCODER_PYTHON__",
  "python.venvPath": "__LOCALCODER_VENV__",
  "python.terminal.activateEnvironment": true,
  "python.languageServer": "Jedi",
  "python.analysis.autoImportCompletions": false,
  "python.experiments.enabled": false,
  "python.telemetry.enabled": false,
  "notebook.experimental.remoteNotebookDiscovery": false,
  "jupyter.disableJupyterAutoStart": true,
  "jupyter.widgetScriptSources": [],
  "sqltools.useNodeRuntime": true,
  "sqltools.disableNodeDetectNotifications": true,
  "sqltools.autoConnectTo": [],
  "sqltools.dependencyManager": {
    "packageManager": "npm",
    "installArgs": ["install"],
    "runScriptArgs": ["run"],
    "autoAccept": true
  },
  "sqltools.connections": [
    {
      "name": "Local SQLite",
      "driver": "SQLite",
      "previewLimit": 100,
      "database": "__LOCALCODER_SQLITE__"
    }
  ],
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true
  },
  "[sql]": {
    "editor.wordBasedSuggestions": "off"
  },
  "files.associations": {
    "*.sql": "sql"
  },
  "editor.inlineSuggest.enabled": false,
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": false
  },
  "workbench.colorCustomizations": {
    "titleBar.activeBackground": "#152028",
    "titleBar.activeForeground": "#E8F4F2",
    "titleBar.inactiveBackground": "#10161C",
    "activityBar.background": "#12181E",
    "activityBar.foreground": "#2EC4B6",
    "activityBarBadge.background": "#2EC4B6",
    "activityBarBadge.foreground": "#102018",
    "statusBar.background": "#0F3D38",
    "statusBar.foreground": "#E8F4F2",
    "statusBar.noFolderBackground": "#0F3D38",
    "sideBar.background": "#141A20"
  }
}
